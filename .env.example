# Copy to .env. Only needed for `npm run feedback` / `civpro run` (API mode).
# Harness mode (Claude Code / Codex acting as the model) needs none of this.

# --- Anthropic (default) ---
ANTHROPIC_API_KEY=
# Optional model overrides. Defaults: fast/work = claude-sonnet-5, evaluator/judge = claude-opus-5-5
# CIVPRO_FAST_MODEL=claude-sonnet-5
# CIVPRO_WORK_MODEL=claude-sonnet-5
# CIVPRO_EVALUATOR_MODEL=claude-opus-5-5
# CIVPRO_JUDGE_MODEL=claude-opus-5-5
# Set to "prompt" to describe the schema in the prompt instead of using native structured output.
# CIVPRO_STRUCTURED_OUTPUT=native

# --- Any OpenAI-compatible endpoint (OpenAI, OpenRouter, a local server, …) ---
# CIVPRO_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=            # used for every tier unless the CIVPRO_*_MODEL overrides are set
# OPENAI_REASONING_EFFORT=off   # uncomment if your endpoint rejects reasoning_effort
